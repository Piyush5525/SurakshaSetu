# Copy to .env (never commit it). Everything is optional; with nothing set the app runs fully SIMULATED.

# --- Central backend (FastAPI) ---
JWT_SECRET=                 # long random string; if empty a random one is used per start (tokens expire on restart)
DEMO_PASSWORD=demo1234      # password of the seeded demo staff accounts (local use only; change for any shared deployment)
CV_WORKER_KEY=dev-worker-key  # shared secret the camera worker uses; change it
PUBLIC_URL=http://localhost:5173      # admin links inside alerts
QR_BASE_URL=http://localhost:5174     # what a QR sticker opens; use http://<this PC's Wi-Fi IP>:5174 for phones

# --- Notifications: SIMULATED unless DEMO_MODE=false ---
DEMO_MODE=true
TELEGRAM_BOT_TOKEN=         # from @BotFather
TELEGRAM_CHAT_ID=           # chat/group id that should receive alerts (from @userinfobot)
# Voice call to the on-call duty number via OmniDimension. Never an emergency-service number (hard-blocked).
CALLS_ENABLED=false
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
OMNIDIM_FROM_NUMBER_ID=
ALERT_PHONE_NUMBER=         # E.164, e.g. +9198XXXXXXXX
CALL_ALLOWLIST=             # extra numbers that may be called, comma separated
ESCALATE_AFTER_S=120        # unacknowledged critical incidents escalate after this long

# --- Retention / limits ---
EVIDENCE_RETENTION_DAYS=30
RATE_LIMIT_PER_MIN=20

# --- Camera worker (3-auto-cv) ---
API_URL=http://127.0.0.1:8000/api
