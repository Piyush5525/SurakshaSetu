{
  "name": "safer-work",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "1-sticker-app",
    "2-user-report-site",
    "functions",
    "rules-tests"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "emulators": "npm run build -w functions && firebase emulators:start --project demo-plant-line3",
    "seed": "tsx scripts/seed/seed.ts",
    "smoke": "tsx scripts/seed/smoke.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/seed --noEmit && tsc -p rules-tests --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-plant-line3 \"npm run test:rules -w rules-tests\"",
    "test:all": "npm test && npm run test:rules",
    "dev:sticker": "npm run dev -w 1-sticker-app",
    "dev:site": "npm run dev -w 2-user-report-site",
    "cv:demo": "cd 3-auto-cv && python -m vision_service --source ../demo-assets/plumbing_test.mp4 --zones plumbing_zones.yaml --vehicle-classes bus --gap-px 100 --sink firestore --auto-report",
    "cv:webcam": "cd 3-auto-cv && python -m vision_service --source 0 --zones webcam_zones.yaml --sink firestore --auto-report",
    "cv:webcam:review": "cd 3-auto-cv && python -m vision_service --source 0 --zones webcam_zones.yaml --sink firestore"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
