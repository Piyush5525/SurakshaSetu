{
  "name": "safer-work",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "1-sticker-app",
    "2-user-report-site"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present && python -m pytest backend/tests -q",
    "dev:sticker": "npm run dev -w 1-sticker-app",
    "dev:site": "npm run dev -w 2-user-report-site",
    "cv:demo": "cd 3-auto-cv && python -m vision_service --source ../demo-assets/plumbing_test.mp4 --zones plumbing_zones.yaml --vehicle-classes bus --gap-px 100 --sink firestore --auto-report",
    "cv:webcam": "cd 3-auto-cv && python -m vision_service --source 0 --zones webcam_zones.yaml --sink firestore --auto-report",
    "cv:webcam:review": "cd 3-auto-cv && python -m vision_service --source 0 --zones webcam_zones.yaml --sink firestore",
    "seed": "python -m backend.app.seed",
    "e2e": "python scripts/e2e/ui_flow.py",
    "api": "python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload",
    "demo:cameras": "cd 3-auto-cv && python -m vision_service.worker --source cam-store=../demo-assets/fire.mp4 --source cam-yard=../demo-assets/office_fight.mp4 --source cam-aisle=../demo-assets/samples/fp_frame_0000.jpg --detectors fire,violence,forklift_person --loop --realtime --cooldown 60",
    "shots": "python scripts/e2e/shots.py demo-assets/shots"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
